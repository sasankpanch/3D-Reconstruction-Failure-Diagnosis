# environments / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# dataset (UAVScenes; download separately, see README)
data/
# heavy intermediates (regenerate with the pipeline)
outputs/**/cache/
*.parquet
*.npz
*.npy
*.ply
outputs/**/*.log
outputs/run_all.log
# paper drafts (double-blind review)
*.tex
*.aux
*.bbl
*.blg
*.out
*.synctex.gz

# line-offset variants: upstream stages are symlinks to the base scene's outputs
outputs/lo/*
!outputs/lo/step2/
!outputs/lo/step3/
outputs/town_lo/*
!outputs/town_lo/step2/
!outputs/town_lo/step3/
# local run helpers
outputs/*.sh
